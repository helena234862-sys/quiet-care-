import { useState, useEffect } from 'react'
import { supabase } from '@/lib/supabase'
import type { Routine } from '@/lib/types'

export default function RoutinesPage() {
  const [routines, setRoutines] = useState<Routine[]>([])

  useEffect(() => {
    const fetchRoutines = async () => {
      const { data } = await supabase
        .from('routines')
        .select('*')
        .limit(10)

      if (data) setRoutines(data)
    }

    fetchRoutines()
  }, [])

  return (
    <div style={{ padding: '20px', maxWidth: '1200px', margin: '0 auto' }}>
      <h2>روتينات يومية</h2>
      <ul>
        <li>☀️ صباح: ماء + تخطيط يومك</li>
        <li>📚 دراسة: 25 دقيقة تركيز</li>
        <li>🌙 ليل: إغلاق الهاتف وراحة</li>
      </ul>

      <h3>روتينات من Supabase:</h3>
      {routines.length > 0 ? (
        routines.map((routine) => (
          <div key={routine.id} style={{ padding: '10px', border: '1px solid #ccc', margin: '10px 0' }}>
            <h4>{routine.title}</h4>
            <p>{routine.description}</p>
          </div>
        ))
      ) : (
        <p>لا توجد روتينات بعد</p>
      )}
    </div>
  )
